programa
{
	
	funcao inicio()
	{
		real A,B, v
		leia(A)
		leia(B)

		v = (A + B)/2

		se (v >= 7 e v < 10) {
			escreva("Aprovado")
		} senao se (v == 10) {
			escreva("Aprovado com Distinção")
		} senao {
			escreva("Reprovado")
			}
		
		
	}
}
