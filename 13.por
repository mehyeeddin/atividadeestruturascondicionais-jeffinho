programa
{
	
	funcao inicio()
	{
		inteiro codigo, q
		real v = 1.0
		leia(codigo)
		leia(q)
		escolha(codigo) {
			caso 100:
				v = 5.0 
				pare
			caso 101:
				v = 2.6
				pare
			caso 102:
				v = 3.8
				pare
			caso 103:
				v = 9.0
				pare
			caso 104:
				v = 11.0
				pare
			caso 105:
				v = 3.0
				pare
			caso 106:
				v = 1000.0
				pare
		}

	escreva(v * q)
	}
}
