programa
{
	
	funcao inicio()
	{
		caracter a
		leia(a)
		se (a == 'a' ou a == 'e' ou a == 'i' ou a == 'o' ou a == 'u' ou a == 'A' ou a == 'E' ou a == 'I' ou a == 'O' ou a == 'U') {
			escreva("Vogal")
		} senao {
			escreva("Consoante")
		}
	}
}
